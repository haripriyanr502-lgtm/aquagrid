# Copy this file to .env (same folder) and fill in your values.  NEVER upload .env to GitHub.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=paste-the-service_role-secret-key-here

# Arduino port: Windows e.g. COM3 | Mac e.g. /dev/cu.usbmodem14101 | Linux e.g. /dev/ttyACM0
SERIAL_PORT=COM3

# Telegram bot token from @BotFather  (BOT_TOKEN is also accepted)
TELEGRAM_BOT_TOKEN=123456789:ABCdefYourTokenHere

# DrainX pothole model (path relative to scripts/)
POTHOLE_MODEL=models/best.pt
POTHOLE_SEGMENT=J2
# 0.25 is the default. Values like 0.10 produce many false positives.
POTHOLE_MIN_CONF=0.25
# Optional USB GPS module (NMEA) for live pothole coordinates, e.g. COM5. Leave empty if none.
GPS_PORT=

# Centre of the digital-twin ward (Silk Board by default) - used for the rain forecast
TWIN_LAT=12.9177
TWIN_LNG=77.6238

LOG_LEVEL=INFO
